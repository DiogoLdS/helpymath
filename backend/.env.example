# Copie este arquivo para ".env". As duas URLs vêm prontas do painel do Neon (Connect / .env),
# já com estes mesmos nomes: é só colar o bloco que o Neon mostra.

# Conexão direta do Neon (host SEM "-pooler"). É a que o Prisma usa nas migrations.
DATABASE_URL="postgresql://USUARIO:SENHA@ep-xxxxx.REGIAO.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Conexão "pooled" do Neon (host COM "-pooler"). É a que o servidor usa.
DATABASE_URL_POOLED="postgresql://USUARIO:SENHA@ep-xxxxx-pooler.REGIAO.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Segredo usado para assinar o login (qualquer texto longo e aleatório)
JWT_SECRET="troque-por-um-texto-longo-e-aleatorio"

# Endereço do site (frontend), pra liberar o CORS. Em desenvolvimento pode ficar sem.
# FRONTEND_URL="https://helpymath.vercel.app"

# Só para trazer os mapas do MySQL antigo (scripts/importar-mapas-mysql.mjs). Pode apagar depois.
# MYSQL_ANTIGO_URL="mysql://usuario:senha@host:3306/nome_do_banco"
# MYSQL_ANTIGO_SSL=true

# Resolução comentada com IA (botão "Gerar com IA" no editor de questões do admin).
# Crie a chave em https://openrouter.ai/keys. Sem ela o resto do site funciona; só o botão avisa que falta.
# OPENROUTER_API_KEY="sk-or-v1-..."
# Modelo usado (opcional). O padrão "openrouter/free" escolhe um modelo gratuito disponível.
# OPENROUTER_MODEL="openrouter/free"
