generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model alternativa {
  id        Int     @id @default(autoincrement())
  questaoId Int
  texto     String  @db.Text
  letra     String
  correta   Boolean
  questao   questao @relation(fields: [questaoId], references: [questaoId], map: "Alternativa_questaoId_fkey")

  @@index([questaoId], map: "Alternativa_questaoId_idx")
}

model conteudo {
  titulo          String
  tipo            Int
  explicacao      String?           @db.Text
  conteudoId      Int               @id @default(autoincrement())
  mapaconteudo    mapaconteudo[]
  usuarioconteudo usuarioconteudo[]
}

model mapaconceitual {
  nome         String
  nivel        String         @default("basico") @db.VarChar(20)
  // Posição do mapa na trilha do nível (menor vem primeiro); o admin reordena no painel
  ordem        Int            @default(0)
  mapaId       Int            @id @default(autoincrement())
  mapaconteudo mapaconteudo[]
  questao      questao[]
}

model mapaconteudo {
  mapaId         Int
  conteudoId     Int
  conteudo       conteudo       @relation(fields: [conteudoId], references: [conteudoId], map: "MapaConteudo_conteudoId_fkey")
  mapaconceitual mapaconceitual @relation(fields: [mapaId], references: [mapaId], map: "MapaConteudo_mapaId_fkey")

  @@id([mapaId, conteudoId])
  @@index([conteudoId], map: "MapaConteudo_conteudoId_idx")
}

model questao {
  mapaId         Int
  data           DateTime       @db.Date
  enunciado      String         @db.Text
  questaoId      Int            @id @default(autoincrement())
  alternativa    alternativa[]
  usuarioquestao usuarioquestao[]
  mapaconceitual mapaconceitual @relation(fields: [mapaId], references: [mapaId], map: "Questao_mapaId_fkey")

  @@index([mapaId], map: "Questao_mapaId_idx")
}

model usuario {
  nome            String
  email           String            @unique(map: "Usuario_email_key")
  senha           String
  usuarioId       Int               @id @default(autoincrement())
  admin           Boolean           @default(false)
  // Perfil (Figura 4.3.2 do TCC): preferências, meta da semana (RF016), anotações e cronograma
  criadoEm        DateTime          @default(now())
  objetivo        String?           @db.VarChar(30)
  metaSemanal     Int               @default(5)
  anotacoes       String?           @db.Text
  // { "seg": "Frações", "ter": "", ... }: o que o aluno planejou estudar em cada dia da semana
  cronograma      Json?
  // Perguntas de boas-vindas (logo depois do cadastro): nível escolhido ou sugerido pelo teste diagnóstico,
  // e quando o aluno terminou as perguntas (null = ainda não respondeu, a página inicial manda pra lá)
  nivel           String?           @db.VarChar(20)
  boasVindasEm    DateTime?
  usuarioconteudo usuarioconteudo[]
  usuarioquestao  usuarioquestao[]
}

model usuarioconteudo {
  usuarioId  Int
  conteudoId Int
  concluido  Boolean  @default(false)
  // Quando o aluno marcou como concluído (histórico de estudos, sequência de dias e meta da semana)
  concluidoEm DateTime?
  conteudo   conteudo @relation(fields: [conteudoId], references: [conteudoId], map: "UsuarioConteudo_conteudoId_fkey")
  usuario    usuario  @relation(fields: [usuarioId], references: [usuarioId], map: "UsuarioConteudo_usuarioId_fkey")

  @@id([usuarioId, conteudoId])
  @@index([conteudoId], map: "UsuarioConteudo_conteudoId_idx")
}

// Resposta de um aluno a uma questão (a última tentativa; refazer substitui).
// alternativaId não tem chave estrangeira de propósito: se o admin apagar a alternativa, a resposta continua valendo.
// Apagar a questão apaga as respostas dela junto (onDelete: Cascade).
model usuarioquestao {
  usuarioId     Int
  questaoId     Int
  alternativaId Int
  correta       Boolean
  respondidaEm  DateTime @default(now())
  usuario       usuario  @relation(fields: [usuarioId], references: [usuarioId], map: "UsuarioQuestao_usuarioId_fkey")
  questao       questao  @relation(fields: [questaoId], references: [questaoId], onDelete: Cascade, map: "UsuarioQuestao_questaoId_fkey")

  @@id([usuarioId, questaoId])
  @@index([questaoId], map: "UsuarioQuestao_questaoId_idx")
}
